# Gemini API Key (Primary reader and grader)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API Key (Secondary vision reader: qwen/qwen3.8-27b; text fallback: openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Server Ports
PORT=3000
BACKEND_PORT=8000
